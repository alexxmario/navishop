# Database
MONGODB_URI=mongodb://localhost:27017/piloton

# Session Secret
SESSION_SECRET=your-session-secret-key

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# SmartBill Configuration
# All billing companies share one SmartBill account; only CIF and series differ.
SMARTBILL_USERNAME=your-smartbill-username
SMARTBILL_TOKEN=your-smartbill-token
SMARTBILL_CIF=your-company-cif
SMARTBILL_SERIES=FACT
# Second billing company (Perfect Century)
SMARTBILL_CIF_PC=second-company-cif
SMARTBILL_SERIES_PC=PC

# Email (SMTP via nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=your-app-password
# Optional friendly "from" address (defaults to EMAIL_USER)
EMAIL_FROM=PilotOn <your-email@gmail.com>
# Where admin notifications (B2B applications, contact messages) are sent
ADMIN_EMAIL=admin@piloton.ro
# Base URL of the admin panel, used in notification email links
ADMIN_PANEL_URL=http://localhost:3002

# Frontend URL for payment redirects
FRONTEND_URL=http://localhost:3000

# Allowed origins for CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# FAN Courier Configuration
# One account per billing company: the sender printed on an AWB is the owner of
# the account behind clientId, so each company needs its own Self AWB account.
# clientId is the numeric branch id — read it from GET /reports/branches.
FAN_COURIER_CLIENT_ID=your-fan-courier-client-id
FAN_COURIER_USERNAME=your-fan-courier-username
FAN_COURIER_PASSWORD=your-fan-courier-password
# Second billing company (Perfect Century)
FAN_COURIER_CLIENT_ID_PC=second-fan-courier-client-id
FAN_COURIER_USERNAME_PC=second-fan-courier-username
FAN_COURIER_PASSWORD_PC=second-fan-courier-password
FAN_COURIER_SENDER_NAME=Your Company Name
FAN_COURIER_SENDER_PHONE=+40123456789
FAN_COURIER_CONTACT_PERSON=Contact Person Name
FAN_COURIER_ORIGIN_CITY=Bucuresti

# EuPlatesc Configuration
EUPLATESC_MERCHANT_ID=your-merchant-id
EUPLATESC_KEY=your-hex-key
EUPLATESC_ENDPOINT=https://secure.euplatesc.ro/tdsprocess/tranzactd.php
EUPLATESC_MERCHANT_NAME=Your Store Name
EUPLATESC_MERCHANT_URL=https://www.example.com

# Server Port
PORT=5000
